# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Empty optional variables fall back to the default noted beside them.

# --- Postgres (docker compose + server) ---
# Required. Any names you like, e.g. kurisu / kurisu.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional, default 5432.
POSTGRES_PORT=
# Required. postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=

# --- MyAnimeList API app (https://myanimelist.net/apiconfig, App Type: web) ---
# Required.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Optional, default http://localhost:3000/api/auth/mal/callback. Must exactly match the
# App Redirect URL registered with MAL.
MAL_REDIRECT_URI=
# Optional, defaults https://myanimelist.net/v1/oauth2 and https://api.myanimelist.net/v2.
# Only tests point these elsewhere.
MAL_AUTH_BASE_URL=
MAL_API_BASE_URL=

# --- AniList (airing schedules and streaming links; public API, no key) ---
# Optional, default https://graphql.anilist.co. Only tests point it elsewhere.
ANILIST_API_URL=

# --- Secrets ---
# Required. 32 random bytes, base64. Encrypts MAL tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Web push (morning brief notifications) ---
# Optional; push is off unless all three are set. Generate the key pair with
#   pnpm --filter @kurisu/server push:keys
# VAPID_SUBJECT is a contact for push services: mailto:<your email> or an https:// URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Server ---
# Optional, default development. The hosted app runs with production (deploy/compose.yaml),
# which makes cookies HTTPS-only and keeps error details out of responses.
NODE_ENV=
# Optional here, required in production. Your MyAnimeList username: when set, no other MAL
# account can sign up (anyone with an account can still log in). Unset, anyone can sign up.
OWNER_MAL_USERNAME=
# Optional, defaults 100 and 5. While OWNER_MAL_USERNAME is set, each other account may start
# this many model runs in any 24 hours, and all of them together may spend this many dollars
# (estimated at config/models.json's list prices) in a calendar month. The owner is never limited.
FRIEND_DAILY_RUNS=
MONTHLY_MODEL_BUDGET_USD=
# Optional, default localhost.
SERVER_HOST=
# Optional, default 4000.
SERVER_PORT=
# Optional, default info. One of fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=
# Optional, default http://localhost:3000. The web app's origin; POSTs from any other origin
# are rejected.
WEB_ORIGIN=

# --- Web ---
# Optional, default http://localhost:4000. Where the Next.js app proxies /api/* to.
API_INTERNAL_URL=

# --- Models (which model plays each role lives in apps/server/config/models.json) ---
# Required for the chat agent (not for evals). Free tier key from https://aistudio.google.com.
GEMINI_API_KEY=
# Optional, default http://127.0.0.1:11434. Local Ollama server for eval runs.
OLLAMA_BASE_URL=
# Optional overrides of config/models.json roles, as provider:model (e.g. ollama:qwen3.6:27b).
AGENT_MODEL=
AGENT_ESCALATION_MODEL=
EVAL_MODEL=
BRIEF_MODEL=
RECOMMEND_MODEL=

# --- Morning brief ---
# Optional, default on. "off" stops the daily brief job (the brief routes still work).
BRIEF_SCHEDULER=
