{
  "name": "@kurisu/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "dev:fake-mal": "tsx test/support/runFakeMal.ts",
    "eval:validate": "tsx eval/src/cli/validate.ts",
    "eval:snapshot": "tsx eval/src/cli/exportSnapshot.ts",
    "eval:lookup": "tsx eval/src/cli/lookup.ts",
    "eval:airing": "tsx eval/src/cli/exportAiring.ts",
    "eval:catalog": "tsx eval/src/cli/exportCatalog.ts",
    "eval:recommend": "tsx eval/src/cli/recommend.ts",
    "eval:import": "tsx eval/src/cli/import.ts",
    "eval:recommend-data": "tsx eval/src/cli/exportRecommendData.ts",
    "eval:streaming": "tsx eval/src/cli/exportStreaming.ts",
    "llm:smoke": "tsx src/scripts/llmSmoke.ts",
    "push:keys": "tsx src/scripts/vapidKeys.ts",
    "eval": "tsx eval/src/cli/run.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@google/genai": "^2.25.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.36.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kurisu/shared": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
