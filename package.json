{
  "name": "kurisu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "pnpm --filter @kurisu/server db:migrate",
    "db:generate": "pnpm --filter @kurisu/server db:generate",
    "eval:validate": "pnpm --filter @kurisu/server eval:validate",
    "eval:snapshot": "pnpm --filter @kurisu/server eval:snapshot",
    "llm:smoke": "pnpm --filter @kurisu/server llm:smoke"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
