{
  "name": "kurisu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "pnpm --filter @kurisu/server db:migrate",
    "db:generate": "pnpm --filter @kurisu/server db:generate",
    "eval:validate": "pnpm --filter @kurisu/server eval:validate",
    "eval:snapshot": "pnpm --filter @kurisu/server eval:snapshot",
    "eval:lookup": "pnpm --filter @kurisu/server eval:lookup",
    "eval:airing": "pnpm --filter @kurisu/server eval:airing",
    "eval:catalog": "pnpm --filter @kurisu/server eval:catalog",
    "eval:recommend": "pnpm --filter @kurisu/server eval:recommend",
    "eval:import": "pnpm --filter @kurisu/server eval:import",
    "eval:diary": "pnpm --filter @kurisu/server eval:diary",
    "eval:recommend-data": "pnpm --filter @kurisu/server eval:recommend-data",
    "eval:streaming": "pnpm --filter @kurisu/server eval:streaming",
    "eval:season": "pnpm --filter @kurisu/server eval:season",
    "eval:synopses": "pnpm --filter @kurisu/server eval:synopses",
    "lab:synopses": "pnpm --filter @kurisu/server lab:synopses",
    "lab:search-replay": "pnpm --filter @kurisu/server lab:search-replay",
    "lab:ask": "pnpm --filter @kurisu/server lab:ask",
    "eval:rag": "pnpm --filter @kurisu/server eval:rag",
    "llm:smoke": "pnpm --filter @kurisu/server llm:smoke",
    "eval": "pnpm --filter @kurisu/server eval",
    "review": "pnpm --filter @kurisu/server review"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
