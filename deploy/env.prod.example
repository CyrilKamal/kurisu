# The hosted kurisu's settings. Copy this to .env.prod at the root of the hosted app's checkout
# (deploy/README.md) and fill it in there. .env.prod is gitignored; never commit or paste it.
# Make random values with Node:
#   keys:      node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   passwords: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# --- Postgres: the hosted app's own database, apart from dev ---
POSTGRES_USER=kurisu
# A new random password, hex only, so it fits in a database URL as it is.
POSTGRES_PASSWORD=
POSTGRES_DB=kurisu
# Optional, default 5433. The database answers only on this PC (127.0.0.1).
PROD_DB_PORT=

# --- The public address: Tailscale Funnel ---
# https://<pc>.<tailnet>.ts.net, with no trailing slash. Writes from any other origin are refused.
WEB_ORIGIN=
# WEB_ORIGIN followed by /api/auth/mal/callback. Must match the App Redirect URL of the hosted
# MAL app exactly.
MAL_REDIRECT_URI=
# Optional, default 3080. The port on this PC that Funnel publishes (127.0.0.1 only).
PROD_WEB_PORT=

# --- Who can sign up ---
# Your MyAnimeList username. Only this account can create a kurisu account (plus anyone with an
# account already); everyone else is told kurisu is invite-only.
OWNER_MAL_USERNAME=

# --- The hosted app's own MyAnimeList API app (https://myanimelist.net/apiconfig), not dev's ---
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# --- Secrets ---
# A new key, not the dev one. Encrypts MAL tokens at rest; if it changes, everyone logs in again.
TOKEN_ENCRYPTION_KEY=
# The same paid-tier key as dev is fine.
GEMINI_API_KEY=
# A new pair: pnpm --filter @kurisu/server push:keys (in the dev checkout). VAPID_SUBJECT is
# mailto:<your email>. Without all three, push and the morning brief are off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Optional ---
# Default info.
LOG_LEVEL=
# Where the daily backups go. Default: backups/ beside this checkout. A synced folder (OneDrive,
# say) keeps a copy off this PC.
BACKUP_DIR=
